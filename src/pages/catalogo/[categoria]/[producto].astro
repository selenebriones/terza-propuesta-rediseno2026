---
// Ficha de producto: galería, información técnica, colores de la misma familia y compartir
import PageLayout from '../../../layouts/PageLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { productos, categoriaDe, familiaDe, productosDe, foto, urlCategoria, urlProducto, paginasLinea } from '../../../lib/catalogo';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { categoria: p.categoria, producto: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const cat = categoriaDe(p.categoria);
const familia = familiaDe(p);
// Otras familias de la misma categoría (una tarjeta por familia)
const relacionados = [...new Map(productosDe(p.categoria).filter((x) => x.familia !== p.familia).map((x) => [x.familia, x])).values()].slice(0, 4);
const nombre = `${p.familia} ${p.variante}`;
const linea = paginasLinea[p.categoria];
---

<PageLayout title={`${nombre} | ${cat.nombre} | Terza`} description={p.descripcion || `${nombre}: ${cat.intro}`}>
  <section class="mx-auto max-w-[1440px] px-5 pt-10 md:px-10 md:pt-14">
    <nav class="flex flex-wrap items-center gap-y-1 text-xs text-terza-gray" aria-label="Ruta">
      <a href="/" class="hover:text-terza-black">Inicio</a><span class="mx-2">/</span>
      <a href="/catalogo" class="hover:text-terza-black">Catálogo</a><span class="mx-2">/</span>
      <a href={urlCategoria(cat.slug)} class="hover:text-terza-black">{cat.nombre}</a><span class="mx-2">/</span>
      <span class="text-terza-black">{p.variante}</span>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-16">
      <!-- Galería -->
      <div class="lg:sticky lg:top-32 lg:self-start">
        <div class="relative">
          <div class="aspect-square overflow-hidden rounded-2xl bg-neutral-50">
            <img id="foto-principal" src={foto(p.fotos[0])} alt={nombre} class="size-full object-cover" />
          </div>
          {p.nuevo && <span class="absolute left-4 top-4 rounded-full bg-terza-lime px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-terza-black">Nuevo</span>}

          <!-- Muestras de la galería sobre la foto, abajo a la derecha -->
          {p.fotos.length > 1 && (
            <ul class="absolute bottom-3 right-3 flex gap-2 md:bottom-5 md:right-5 md:gap-3">
              {p.fotos.map((f, i) => (
                <li>
                  <button
                    type="button"
                    class="gallery-thumb block size-14 overflow-hidden rounded-xl border-4 border-white bg-neutral-50 shadow-[0_8px_24px_-8px_rgba(0,0,0,0.35)] transition hover:-translate-y-0.5 data-[active]:ring-[3px] data-[active]:ring-terza-lime md:size-20 md:rounded-2xl"
                    data-src={foto(f)}
                    data-active={i === 0 ? '' : undefined}
                    aria-label={`Ver foto ${i + 1} de ${p.fotos.length}`}
                  >
                    <img src={foto(f, 'sm')} alt="" loading="lazy" class="size-full object-cover" />
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      <!-- Información -->
      <div>
        <p class="eyebrow">{cat.nombre}</p>
        <h1 class="mt-5 text-4xl font-medium uppercase leading-[1.05] tracking-[-0.02em] md:text-5xl">{p.familia}</h1>
        <p class="mt-2 text-2xl font-light text-terza-black md:text-3xl">{p.variante}</p>
        {p.descripcion && <p class="mt-6 max-w-xl text-base leading-relaxed">{p.descripcion}</p>}

        <div class="mt-8 border-t border-terza-black/10 pt-8">
          <h2 class="text-2xl font-medium">Información</h2>
          <dl class="mt-6 grid gap-x-10 gap-y-3 sm:grid-cols-2">
            {p.specs.map(([etiqueta, valor]) => (
              <div class="flex gap-2 border-b border-terza-black/5 pb-3 text-sm">
                <dt class="font-semibold text-terza-black">{etiqueta}:</dt>
                <dd>{valor}</dd>
              </div>
            ))}
          </dl>
        </div>

        {familia.length > 1 && (
          <div class="mt-10">
            <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-terza-black">
              Colores disponibles <span class="font-normal text-terza-gray">({familia.length})</span>
            </h2>
            <ul class="mt-5 flex flex-wrap gap-3">
              {familia.map((x) => (
                <li>
                  <a
                    href={urlProducto(x)}
                    class:list={[
                      'group/sw relative block size-14 overflow-hidden rounded-full bg-neutral-50 ring-offset-2 transition md:size-16',
                      x.slug === p.slug ? 'ring-2 ring-terza-lime' : 'hover:ring-2 hover:ring-terza-black/20',
                    ]}
                    title={x.variante}
                    aria-label={x.variante}
                    aria-current={x.slug === p.slug ? 'page' : undefined}
                  >
                    <img src={foto(x.fotos[0], 'sm')} alt="" loading="lazy" class="size-full scale-150 object-cover" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/#contacto-ubicaciones" class="btn-lime">Solicitar cotización <i class="ph ph-arrow-right"></i></a>
          <a href={urlCategoria(cat.slug)} class="btn-ghost">Ver más {cat.nombre.toLowerCase()}</a>
        </div>
        {linea && (
          <a href={linea.href} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-terza-forest hover:text-terza-black">
            <i class="ph-light ph-info text-lg"></i> {linea.etiqueta} <i class="ph ph-arrow-right"></i>
          </a>
        )}

        <div class="mt-10">
          <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-terza-black">Compartir</h2>
          <ul class="mt-4 flex gap-2">
            <li><a data-share="facebook" href="#" target="_blank" rel="noopener" aria-label="Compartir en Facebook" class="grid size-11 place-items-center rounded-full bg-terza-lime text-lg text-terza-black transition-colors hover:bg-terza-black hover:text-terza-lime"><i class="ph ph-facebook-logo"></i></a></li>
            <li><a data-share="whatsapp" href="#" target="_blank" rel="noopener" aria-label="Compartir por WhatsApp" class="grid size-11 place-items-center rounded-full bg-terza-lime text-lg text-terza-black transition-colors hover:bg-terza-black hover:text-terza-lime"><i class="ph ph-whatsapp-logo"></i></a></li>
            <li><a data-share="linkedin" href="#" target="_blank" rel="noopener" aria-label="Compartir en LinkedIn" class="grid size-11 place-items-center rounded-full bg-terza-lime text-lg text-terza-black transition-colors hover:bg-terza-black hover:text-terza-lime"><i class="ph ph-linkedin-logo"></i></a></li>
            <li><button type="button" data-share="copiar" aria-label="Copiar enlace" class="grid size-11 place-items-center rounded-full bg-terza-lime text-lg text-terza-black transition-colors hover:bg-terza-black hover:text-terza-lime"><i class="ph ph-link"></i></button></li>
          </ul>
          <p class="copy-ok mt-3 hidden text-xs text-terza-forest">Enlace copiado.</p>
        </div>
      </div>
    </div>
  </section>

  {relacionados.length > 0 && (
    <section class="mx-auto max-w-[1440px] px-5 pt-24 md:px-10 md:pt-32">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="eyebrow">{cat.nombre}</p>
          <h2 class="mt-5 text-3xl font-light md:text-4xl">También te puede <span class="font-medium">interesar</span></h2>
        </div>
        <a href={urlCategoria(cat.slug)} class="hidden items-center gap-2 text-sm font-semibold text-terza-black hover:text-terza-forest sm:inline-flex">
          Ver toda la categoría <i class="ph ph-arrow-right"></i>
        </a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 md:gap-6 lg:grid-cols-4">
        {relacionados.map((x) => <ProductCard producto={x} />)}
      </div>
    </section>
  )}

  <script is:inline slot="scripts">
    document.addEventListener('DOMContentLoaded', () => {
      // Galería: la miniatura elegida pasa a la foto principal
      const principal = document.getElementById('foto-principal');
      const thumbs = document.querySelectorAll('.gallery-thumb');
      thumbs.forEach((t) => t.addEventListener('click', () => {
        principal.src = t.dataset.src;
        thumbs.forEach((x) => x.toggleAttribute('data-active', x === t));
      }));

      // Compartir con la URL actual de la ficha
      const url = encodeURIComponent(location.href);
      const texto = encodeURIComponent(document.title);
      const destinos = {
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${url}`,
        whatsapp: `https://wa.me/?text=${texto}%20${url}`,
        linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${url}`,
      };
      document.querySelectorAll('a[data-share]').forEach((a) => { a.href = destinos[a.dataset.share]; });
      document.querySelector('[data-share="copiar"]').addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(location.href); } catch { /* sin permiso de portapapeles */ }
        const ok = document.querySelector('.copy-ok');
        ok.classList.remove('hidden');
        setTimeout(() => ok.classList.add('hidden'), 2500);
      });
    });
  </script>
</PageLayout>
