  <script is:inline slot="scripts">
    document.addEventListener('DOMContentLoaded', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---------- Header: glassmorphism al hacer scroll ---------- */
      const header = document.getElementById('site-header');
      const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      /* ---------- Mega menú: la subcategoría con el cursor cambia las colecciones ---------- */
      document.querySelectorAll('.mega').forEach((mega) => {
        const tabs = mega.querySelectorAll('.mega-tab');
        const panes = mega.querySelectorAll('.mega-pane');
        const activate = (j) => {
          tabs.forEach((t) => t.toggleAttribute('data-active', t.dataset.tab === String(j)));
          panes.forEach((p) => { p.hidden = p.dataset.pane !== String(j); });
        };
        tabs.forEach((t) => {
          t.addEventListener('mouseenter', () => activate(t.dataset.tab));
          t.addEventListener('focus', () => activate(t.dataset.tab));
          t.addEventListener('click', (e) => { e.preventDefault(); activate(t.dataset.tab); });
        });
        // Al salir del menú vuelve a la primera subcategoría
        mega.closest('li').addEventListener('mouseleave', () => activate(0));
      });

      /* ---------- Menú móvil: panel lateral con navegación por niveles ---------- */
      const toggle = document.getElementById('menu-toggle');
      const drawer = document.getElementById('mobile-drawer');
      const drawerPanel = drawer.querySelector('.drawer-panel');
      const drawerBackdrop = drawer.querySelector('.drawer-backdrop');
      const drawerClose = drawer.querySelector('.drawer-close');
      const drawerBack = drawer.querySelector('.drawer-back');
      const drawerTitle = drawer.querySelector('.drawer-title');
      const drawerLogo = drawer.querySelector('.drawer-logo');
      const levels = [...drawer.querySelectorAll('.drawer-level')];
      let stack = ['root'];
      let drawerTimer = null;

      const renderLevels = () => {
        const current = stack[stack.length - 1];
        levels.forEach((level) => {
          const id = level.dataset.level;
          const pos = id === current ? '0%' : stack.includes(id) ? '-30%' : '100%';
          level.style.transform = `translateX(${pos})`;
          level.inert = id !== current;
        });
        const nested = stack.length > 1;
        drawerBack.classList.toggle('hidden', !nested);
        drawerBack.classList.toggle('flex', nested);
        drawerLogo.classList.toggle('hidden', nested);
        drawerTitle.textContent = levels.find((l) => l.dataset.level === current).dataset.title;
      };
      levels.forEach((level) => level.classList.add('transition-transform', 'duration-500', 'ease-silk'));

      const openDrawer = () => {
        clearTimeout(drawerTimer);
        stack = ['root'];
        renderLevels();
        drawer.hidden = false;
        document.documentElement.classList.add('search-sin-scroll');
        toggle.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => {
          drawerPanel.classList.remove('-translate-x-full');
          drawerBackdrop.classList.add('opacity-100');
          drawerClose.classList.add('opacity-100');
        });
      };

      const closeDrawer = () => {
        drawerPanel.classList.add('-translate-x-full');
        drawerBackdrop.classList.remove('opacity-100');
        drawerClose.classList.remove('opacity-100');
        document.documentElement.classList.remove('search-sin-scroll');
        toggle.setAttribute('aria-expanded', 'false');
        drawerTimer = setTimeout(() => { drawer.hidden = true; }, 500);
      };

      toggle.addEventListener('click', openDrawer);
      drawerClose.addEventListener('click', closeDrawer);
      drawerBackdrop.addEventListener('click', closeDrawer);
      drawerBack.addEventListener('click', () => { stack.pop(); renderLevels(); });
      drawer.addEventListener('click', (e) => {
        const go = e.target.closest('[data-go]');
        if (go) { stack.push(go.dataset.go); renderLevels(); return; }
        if (e.target.closest('a[href]')) closeDrawer();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.hidden) closeDrawer();
      });

      /* ---------- Buscador de pantalla completa ---------- */
      const capa = document.getElementById('buscador');
      const campo = capa.querySelector('.search-input');
      const lista = capa.querySelector('.search-results');
      const vacio = capa.querySelector('.search-empty');
      const populares = capa.querySelector('.search-popular');
      const indice = JSON.parse(document.getElementById('search-index').textContent);
      const disparadores = document.querySelectorAll('.search-open');
      let origen = null;
      let temporizador = null;
      const normalizar = (t) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

      const pintar = () => {
        const q = normalizar(campo.value.trim());
        const palabras = q.split(/\s+/).filter(Boolean);
        const hallados = palabras.length
          ? indice.filter((r) => palabras.every((w) => normalizar(`${r.title} ${r.cat}`).includes(w))).slice(0, 8)
          : [];
        populares.classList.toggle('hidden', palabras.length > 0);
        vacio.classList.toggle('hidden', !palabras.length || hallados.length > 0);
        lista.innerHTML = hallados.map((r) => `
          <li>
            <a href="${r.href}" class="search-link group flex items-center justify-between gap-6 py-4 text-white">
              <span>
                <span class="block font-display text-xl transition-colors group-hover:text-terza-lime md:text-2xl">${r.title}</span>
                <span class="mt-1 block text-xs uppercase tracking-[0.16em] text-white/50">${r.cat}</span>
              </span>
              <i class="ph ph-arrow-up-right text-xl transition-transform group-hover:-translate-y-1 group-hover:translate-x-1"></i>
            </a>
          </li>`).join('');
      };

      const abrirBuscador = (disparador) => {
        clearTimeout(temporizador);
        origen = disparador || document.activeElement;
        campo.value = '';
        pintar();
        capa.hidden = false;
        document.documentElement.classList.add('search-sin-scroll');
        disparadores.forEach((d) => d.setAttribute('aria-expanded', 'true'));
        // El foco va en el mismo toque: en iPhone el teclado solo se abre así
        campo.focus({ preventScroll: true });
        requestAnimationFrame(() => capa.classList.add('is-abierta'));
      };

      const cerrarBuscador = () => {
        capa.classList.remove('is-abierta');
        document.documentElement.classList.remove('search-sin-scroll');
        disparadores.forEach((d) => d.setAttribute('aria-expanded', 'false'));
        temporizador = setTimeout(() => { capa.hidden = true; }, 400);
        origen?.focus?.();
      };

      disparadores.forEach((d) => d.addEventListener('click', () => abrirBuscador(d)));
      capa.querySelector('.search-close').addEventListener('click', cerrarBuscador);
      capa.addEventListener('click', (e) => {
        if (e.target === capa) cerrarBuscador();
        if (e.target.closest('.search-link')) cerrarBuscador();
        const chip = e.target.closest('.search-chip');
        if (chip) { campo.value = chip.dataset.term; pintar(); campo.focus(); }
      });
      campo.addEventListener('input', pintar);
      capa.querySelector('.search-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const primero = lista.querySelector('a');
        if (primero) { cerrarBuscador(); window.location.href = primero.getAttribute('href'); }
        else campo.focus();
      });
      document.addEventListener('keydown', (e) => {
        if (capa.hidden) return;
        if (e.key === 'Escape') cerrarBuscador();
        if (e.key === 'Tab') {
          // Mantener el foco dentro de la capa
          const focos = capa.querySelectorAll('button, input, a[href]');
          const primero = focos[0];
          const ultimo = focos[focos.length - 1];
          if (e.shiftKey && document.activeElement === primero) { e.preventDefault(); ultimo.focus(); }
          else if (!e.shiftKey && document.activeElement === ultimo) { e.preventDefault(); primero.focus(); }
        }
      });
      window.addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        campo.value = '';
        capa.classList.remove('is-abierta');
        capa.hidden = true;
        document.documentElement.classList.remove('search-sin-scroll');
      });

      /* ---------- Swiper: galería de productos ---------- */
      if (window.Swiper) {
        new Swiper('.products-swiper', {
          slidesPerView: 1.15,
          spaceBetween: 16,
          speed: 900,
          grabCursor: true,
          navigation: { prevEl: '.products-prev', nextEl: '.products-next' },
          pagination: { el: '.products-progress', type: 'progressbar' },
          breakpoints: {
            640: { slidesPerView: 2.15, spaceBetween: 20 },
            1024: { slidesPerView: 3.15, spaceBetween: 28 },
            1440: { slidesPerView: 3.6, spaceBetween: 32 },
          },
        });
      }

      /* ---------- GSAP ---------- */
      if (!window.gsap || reduceMotion) {
        document.documentElement.classList.remove('js');
        return;
      }
      gsap.registerPlugin(ScrollTrigger);
      gsap.defaults({ ease: 'expo.out', duration: 1.4 });

      // Hero: slider con barrido lateral, parallax entre imágenes y revelado de textos por máscara
      const hero = document.querySelector('.hero');
      const slides = gsap.utils.toArray('.hero-slide');
      const imgs = slides.map((slide) => slide.querySelector('.hero-img'));
      const shades = slides.map((slide) => slide.querySelector('.hero-slide-shade'));
      const copies = gsap.utils.toArray('.hero-copy-slide');
      const dots = gsap.utils.toArray('.hero-dot');
      const fills = dots.map((dot) => dot.querySelector('.hero-dot-fill'));
      const wipe = document.querySelector('.hero-wipe');
      const counter = document.querySelector('.hero-count-current');
      const AUTOPLAY = 7;
      let current = 0;
      let busy = false;
      let kenBurns;
      let progress;
      let hovering = false;
      let offscreen = false;

      const lines = (i) => copies[i].querySelectorAll('.reveal-line > span');
      const fades = (i) => copies[i].querySelectorAll('.hero-eyebrow, .hero-copy, .hero-ctas');
      gsap.set('.hero-copy-slide .reveal-line > span', { y: 0, yPercent: 110 });
      gsap.set(slides, { zIndex: (i) => (i === 0 ? 2 : 1) });

      const setFocusable = (i, on) => {
        copies[i].querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
        [copies[i], slides[i]].forEach((el) => (on ? el.removeAttribute('aria-hidden') : el.setAttribute('aria-hidden', 'true')));
      };

      const showCopy = (i) => {
        gsap.set(copies[i], { visibility: 'visible' });
        setFocusable(i, true);
        return gsap.timeline()
          .fromTo(lines(i), { yPercent: 110 }, { yPercent: 0, stagger: 0.12, duration: 1.3, ease: 'expo.out' }, 0)
          .fromTo(fades(i), { opacity: 0, y: 24 }, { opacity: 1, y: 0, stagger: 0.1, duration: 1.1, ease: 'expo.out' }, 0.25);
      };

      const hideCopy = (i) => {
        setFocusable(i, false);
        return gsap.timeline({ onComplete: () => gsap.set(copies[i], { visibility: 'hidden' }) })
          .to(fades(i), { opacity: 0, y: -16, stagger: 0.05, duration: 0.5, ease: 'power2.in' }, 0)
          .to(lines(i), { yPercent: -110, stagger: 0.06, duration: 0.7, ease: 'power3.in' }, 0);
      };

      const syncPause = () => {
        if (!progress) return;
        hovering || offscreen ? progress.pause() : progress.resume();
      };

      const startProgress = (i) => {
        progress?.kill();
        progress = gsap.fromTo(fills[i], { scaleX: 0 }, {
          scaleX: 1,
          duration: AUTOPLAY,
          ease: 'none',
          onComplete: () => goTo((current + 1) % slides.length, 1),
        });
        syncPause();
      };

      // Zoom lento mientras la imagen está activa
      const startKenBurns = (i) => {
        kenBurns?.kill();
        kenBurns = gsap.to(imgs[i], { scale: 1, duration: AUTOPLAY + 2, ease: 'none' });
      };

      function goTo(next, dir = 1) {
        if (busy || next === current) return;
        busy = true;
        progress?.kill();
        kenBurns?.kill();
        gsap.to(fills[current], { scaleX: 0, duration: 0.5, ease: 'power2.out' });

        const prev = current;
        current = next;
        counter.textContent = String(next + 1).padStart(2, '0');

        gsap.set(shades[next], { opacity: 0 });
        gsap.set(slides[prev], { zIndex: 2 });
        gsap.set(slides[next], {
          visibility: 'visible',
          zIndex: 3,
          clipPath: dir > 0 ? 'inset(0% 0% 0% 100%)' : 'inset(0% 100% 0% 0%)',
        });

        gsap.timeline({
          onComplete: () => {
            gsap.set(slides[prev], { visibility: 'hidden', zIndex: 1 });
            gsap.set(imgs[prev], { xPercent: 0, scale: 1.12 });
            gsap.set(shades[prev], { opacity: 0 });
            gsap.set(slides[next], { zIndex: 2, clearProps: 'clipPath' });
            busy = false;
            startKenBurns(next);
            startProgress(next);
          },
        })
          .add(hideCopy(prev), 0)
          .to(slides[next], { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.6, ease: 'expo.inOut' }, 0.2)
          .fromTo(imgs[next], { scale: 1.3, xPercent: dir * 12 }, { scale: 1.12, xPercent: 0, duration: 1.9, ease: 'expo.inOut' }, 0.2)
          .to(imgs[prev], { xPercent: -dir * 15, duration: 1.6, ease: 'expo.inOut' }, 0.2)
          .to(shades[prev], { opacity: 0.45, duration: 1.6, ease: 'expo.inOut' }, 0.2)
          .fromTo(wipe, { left: dir > 0 ? '100%' : '0%', opacity: 1 }, { left: dir > 0 ? '0%' : '100%', duration: 1.6, ease: 'expo.inOut' }, 0.2)
          .to(wipe, { opacity: 0, duration: 0.3 }, 1.6)
          .add(showCopy(next), 1.15);
      }

      const goNext = () => goTo((current + 1) % slides.length, 1);
      const goPrev = () => goTo((current - 1 + slides.length) % slides.length, -1);
      document.querySelector('.hero-next').addEventListener('click', goNext);
      document.querySelector('.hero-prev').addEventListener('click', goPrev);
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i, i > current ? 1 : -1)));

      // Pausa al pasar el cursor y cuando el hero sale de pantalla
      hero.addEventListener('mouseenter', () => { hovering = true; syncPause(); });
      hero.addEventListener('mouseleave', () => { hovering = false; syncPause(); });
      ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        onToggle: (self) => { offscreen = !self.isActive; syncPause(); },
      });

      // Deslizar con el dedo en móvil
      let touchX = null;
      hero.addEventListener('pointerdown', (e) => { touchX = e.clientX; });
      hero.addEventListener('pointerup', (e) => {
        if (touchX === null) return;
        const dx = e.clientX - touchX;
        touchX = null;
        if (Math.abs(dx) > 60) dx < 0 ? goNext() : goPrev();
      });

      // Logo: efecto flair (el círculo entra y sale por donde pasa el cursor)
      document.querySelectorAll('.logo-flair').forEach((logo) => {
        const dot = logo.querySelector('.logo-flair-dot');
        gsap.set(dot, { xPercent: -50, yPercent: -50, scale: 0 });
        const pos = (e) => {
          const r = logo.getBoundingClientRect();
          return { x: e.clientX - r.left, y: e.clientY - r.top };
        };
        logo.addEventListener('mouseenter', (e) => {
          gsap.set(dot, pos(e));
          gsap.to(dot, { scale: 1, duration: 0.7, ease: 'power3.out', overwrite: 'auto' });
        });
        logo.addEventListener('mousemove', (e) => {
          gsap.to(dot, { ...pos(e), duration: 0.5, ease: 'power3.out', overwrite: 'auto' });
        });
        logo.addEventListener('mouseleave', (e) => {
          gsap.to(dot, { ...pos(e), scale: 0, duration: 0.5, ease: 'power3.inOut', overwrite: 'auto' });
        });
      });

      // Entrada inicial
      gsap.timeline({ delay: 0.15, onComplete: () => { startKenBurns(0); startProgress(0); } })
        .fromTo(imgs[0], { scale: 1.25 }, { scale: 1.12, duration: 2.4, ease: 'power3.out' })
        .add(showCopy(0), 0.35)
        .fromTo('.site-header', { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 1, clearProps: 'transform,opacity' }, 0.5)
        .fromTo('.site-rail', { x: -30, opacity: 0 }, { x: 0, opacity: 1, duration: 1, clearProps: 'transform,opacity' }, 0.5)
        .fromTo('.hero-controls', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 1.2 }, 1);

      // Elementos genéricos [data-reveal] (excepto los del hero)
      gsap.utils.toArray('[data-reveal]').forEach((el) => {
        if (el.matches('.hero-eyebrow, .hero-copy, .hero-ctas, .blog-card')) return;
        gsap.fromTo(el, { opacity: 0, y: 40 }, {
          opacity: 1,
          y: 0,
          scrollTrigger: { trigger: el, start: 'top 85%' },
        });
      });

      // About: título con máscara + imagen con revelado tipo cortina y parallax
      gsap.to('.about-title .reveal-line > span', {
        y: 0,
        stagger: 0.12,
        scrollTrigger: { trigger: '.about-title', start: 'top 80%' },
      });
      gsap.fromTo('.about-figure', { clipPath: 'inset(100% 0% 0% 0%)' }, {
        clipPath: 'inset(0% 0% 0% 0%)',
        duration: 1.6,
        ease: 'expo.inOut',
        scrollTrigger: { trigger: '.about-figure', start: 'top 80%' },
      });
      gsap.fromTo('.stat-card', { opacity: 0, x: -40 }, {
        opacity: 1,
        x: 0,
        stagger: 0.15,
        delay: 0.6,
        scrollTrigger: { trigger: '.about-media', start: 'top 75%' },
      });
      gsap.to('.about-img', {
        yPercent: -8,
        ease: 'none',
        scrollTrigger: { trigger: '.about-figure', start: 'top bottom', end: 'bottom top', scrub: true },
      });

      // Visualizador: la imagen de fondo entra con un zoom suave
      gsap.fromTo('.viz-img', { scale: 1.12 }, {
        scale: 1,
        duration: 2,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.viz-box', start: 'top 75%' },
      });

      // ShawContract: tarjetas en cascada
      gsap.fromTo('.shaw-card', { opacity: 0, y: 60 }, {
        opacity: 1,
        y: 0,
        stagger: 0.12,
        scrollTrigger: { trigger: '.shaw-cards', start: 'top 85%' },
      });

      // Contacto y ubicaciones: fotos con revelado tipo cortina
      gsap.utils.toArray('.cu-photo').forEach((photo, i) => {
        gsap.fromTo(photo, { clipPath: 'inset(100% 0% 0% 0%)' }, {
          clipPath: 'inset(0% 0% 0% 0%)',
          duration: 1.6,
          delay: i * 0.15,
          ease: 'expo.inOut',
          scrollTrigger: { trigger: '#contacto-ubicaciones', start: 'top 80%' },
        });
      });

      // Blog: stagger de tarjetas
      ScrollTrigger.batch('.blog-card', {
        start: 'top 88%',
        onEnter: (batch) => gsap.fromTo(batch, { opacity: 0, y: 50 }, { opacity: 1, y: 0, stagger: 0.12, overwrite: true }),
      });

      // Banner distribuidor: entrada con escala sutil
      gsap.fromTo('.dist-banner', { scale: 0.96 }, {
        scale: 1,
        duration: 1.6,
        scrollTrigger: { trigger: '.dist-banner', start: 'top 85%' },
      });
    });
  </script>
</Layout>
