---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const heroSlides = [
  {
    tone: 'light',
    img: '/assets/images/img_hero_actual.webp',
    w: 1730,
    h: 708,
    pos: 'object-[70%_center]',
    alt: 'Muro recubierto con piedra flexible Flexi ROC en una terraza con sillón y mesa de madera',
    eyebrow: 'Nuevo · Flexi ROC',
    lines: [['La piedra,'], ['ahora ', 'flexible.']],
    copy: 'Láminas de piedra natural de apenas 2 mm que se adaptan a muros curvos, columnas y fachadas. La nobleza de la roca, sin su peso.',
    cta: { label: 'Explorar Flexi ROC', href: '/catalogo/flexiroc' },
  },
  {
    tone: 'dark',
    img: '/assets/images/banner-hero-muros-verdes.webp',
    w: 2000,
    h: 805,
    pos: 'object-center',
    alt: 'Muro verde sintético en un jardín con alberca y deck de madera',
    eyebrow: 'Muros verdes',
    lines: [['Naturaleza'], ['', 'vertical.']],
    copy: 'Jardines verticales que no necesitan riego ni poda y se ven vivos los 365 días del año.',
    cta: { label: 'Explorar muros verdes', href: '/catalogo/muros-verdes' },
  },
  {
    tone: 'dark',
    img: '/assets/images/banner-hero-pasto-sintetico.webp',
    w: 2000,
    h: 806,
    pos: 'object-[65%_center]',
    alt: 'Niño recostado sobre pasto sintético Terza',
    eyebrow: 'Pasto sintético',
    lines: [['Verde perfecto,'], ['', 'todo el año.']],
    copy: 'Césped sintético suave al tacto y seguro para jugar, que conserva su color sin riego ni mantenimiento.',
    cta: { label: 'Explorar pasto sintético', href: '/catalogo/pasto-sintetico' },
  },
  {
    tone: 'dark',
    img: '/assets/images/banner-hero-piso-vinilico.webp',
    w: 2000,
    h: 806,
    pos: 'object-center',
    alt: 'Sala con piso vinílico con apariencia de madera y vista al jardín',
    eyebrow: 'Pisos vinílicos',
    lines: [['Calidez que'], ['', 'resiste todo.']],
    copy: 'La apariencia de la madera natural, resistente al agua y al tráfico diario, silenciosa y fácil de mantener.',
    cta: { label: 'Explorar pisos vinílicos', href: '/catalogo/piso-vinilico' },
  },
];

// Nuevos productos de terza.com (imágenes en /assets/images/flexiroc/)
const productos = [
  { name: 'Travertino Greige', code: 'T15-FR026-GT101' },
  { name: 'Granito Gris Perla', code: 'T15-FR026-FG126' },
  { name: 'Gris Pavimento', code: 'T15-FR026-TGG103' },
  { name: 'Travertino Romano Beige', code: 'T15-FR026-PT205' },
  { name: 'Arenisca', code: 'T15-FR026-SL106' },
  { name: 'Caliza Española', code: 'T15-FR026-SL107' },
].map((p) => ({
  ...p,
  img: `/assets/images/flexiroc/${p.code}.webp`,
  thumb: `/assets/images/flexiroc/${p.code}-detalle.webp`,
  href: `/catalogo/flexiroc/${p.code.toLowerCase()}`,
}));


const stats = [
  { value: '+45', unit: 'años', label: 'de experiencia' },
];

const shawSectores = [
  { name: 'Workplace', desc: 'Oficinas y corporativos', img: '/assets/images/shaw-workplace.webp', pos: 'object-[35%_center]' },
  { name: 'Hospitality', desc: 'Hoteles y restaurantes', img: '/assets/images/hospitality.webp', pos: 'object-[40%_center]' },
  { name: 'Education', desc: 'Escuelas y universidades', img: '/assets/images/education.webp', pos: 'object-[60%_center]' },
  { name: 'Healthcare', desc: 'Hospitales y clínicas', img: '/assets/images/healthcare.webp', pos: 'object-center' },
];

const posts = [
  {
    cat: 'Pisos',
    title: 'Piso laminado vs. vinílico: Guía definitiva para elegir el ideal.',
    img: '/assets/images/blog-pisos.webp',
    href: '#',
  },
  {
    cat: 'Tips',
    title: '¿Cómo elegir alfombras para oficinas de alto, medio y bajo tráfico?',
    img: '/assets/images/blog-tips.webp',
    href: '#',
  },
  {
    cat: 'Muros',
    title: 'Tipos de lambrín: ¿Cómo elegir entre colores claros y oscuros para tus muros?',
    img: '/assets/images/blog-muros.webp',
    href: '#',
  },
];
---

<Layout>
  <SiteHeader />

  <main class="lg:pl-24">
    <!-- ============ B. HERO (slider) ============ -->
    <section class="hero relative flex min-h-screen items-end overflow-hidden lg:-ml-24 lg:pl-24" aria-labelledby="hero-title" aria-roledescription="carrusel">
      <h1 id="hero-title" class="sr-only">Terza: pisos, recubrimientos y superficies de alto diseño</h1>

      <!-- Imágenes: se apilan; GSAP revela la siguiente con un barrido lateral -->
      <div class="hero-slides absolute inset-0">
        {heroSlides.map((slide, i) => (
          <div class:list={['hero-slide absolute inset-0 overflow-hidden', i > 0 && 'invisible']} aria-hidden={i > 0 ? 'true' : undefined}>
            <img
              src={slide.img}
              alt={slide.alt}
              width={slide.w}
              height={slide.h}
              class:list={['hero-img absolute inset-0 size-full object-cover', slide.pos]}
              fetchpriority={i === 0 ? 'high' : 'low'}
            />
            {slide.tone === 'light' ? (
              <div class="absolute inset-0 bg-gradient-to-t from-white/80 via-white/10 to-white/30"></div>
            ) : (
              <>
                <div class="absolute inset-0 bg-gradient-to-tr from-black/70 via-black/25 to-transparent"></div>
                <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-white/70 to-transparent"></div>
              </>
            )}
            <div class="hero-slide-shade absolute inset-0 bg-black opacity-0"></div>
          </div>
        ))}
        <span class="hero-wipe pointer-events-none absolute inset-y-0 z-10 w-0.5 bg-terza-lime opacity-0"></span>
      </div>

      <!-- Textos: todos ocupan la misma celda de la cuadrícula -->
      <div class="relative z-10 mx-auto w-full max-w-[1440px] px-5 pb-32 pt-32 md:px-10 md:pb-36">
        <div class="hero-copies grid">
          {heroSlides.map((slide, i) => {
            const dark = slide.tone === 'dark';
            return (
              <div class:list={['hero-copy-slide [grid-area:1/1]', i > 0 && 'invisible']} aria-hidden={i > 0 ? 'true' : undefined}>
                <p class:list={['hero-eyebrow eyebrow mb-6', dark && '!text-terza-lime']} data-reveal>{slide.eyebrow}</p>
                <h2 class:list={['max-w-5xl text-[clamp(2.75rem,8.5vw,8rem)] font-light leading-[0.95] tracking-[-0.05em]', dark ? '!text-white' : 'text-terza-black']}>
                  {slide.lines.map(([light, bold]) => (
                    <span class="reveal-line block overflow-hidden pb-[0.08em]"><span>{light}{bold && <em class="font-medium not-italic">{bold}</em>}</span></span>
                  ))}
                </h2>
                <div class="mt-10 flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
                  <p class:list={['hero-copy max-w-md text-base leading-relaxed md:text-lg', dark ? 'text-white/85' : 'text-terza-black/70']} data-reveal>
                    {slide.copy}
                  </p>
                  <div class="hero-ctas flex flex-wrap gap-3" data-reveal>
                    <a href={slide.cta.href} class="btn-lime" tabindex={i > 0 ? '-1' : undefined}>{slide.cta.label} <i class="ph ph-arrow-right"></i></a>
                    <a
                      href="#visualizador"
                      class:list={['btn-ghost backdrop-blur', dark ? '!border-white/40 bg-white/10 !text-white hover:!border-white' : 'bg-white/50']}
                      tabindex={i > 0 ? '-1' : undefined}
                    >Visualizar en mi espacio</a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Controles: contador, barras de progreso y flechas -->
      <div class="hero-controls absolute bottom-6 left-5 right-5 z-20 flex items-center gap-5 rounded-full bg-white/75 py-2 pl-5 pr-2 shadow-[0_10px_40px_-15px_rgba(0,0,0,0.3)] backdrop-blur-md sm:left-auto md:bottom-10 md:right-10">
        <p class="font-display text-sm tabular-nums text-terza-black" aria-live="polite">
          <span class="hero-count-current font-medium">01</span>
          <span class="text-terza-black/40"> / {String(heroSlides.length).padStart(2, '0')}</span>
        </p>
        <div class="flex flex-1 gap-1.5 sm:flex-none">
          {heroSlides.map((slide, i) => (
            <button type="button" class="hero-dot group relative h-6 flex-1 sm:w-12 sm:flex-none" aria-label={`Ir a ${slide.eyebrow}`}>
              <span class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 overflow-hidden rounded-full bg-terza-black/15 transition-colors group-hover:bg-terza-black/30">
                <span class="hero-dot-fill block size-full origin-left scale-x-0 bg-terza-lime"></span>
              </span>
            </button>
          ))}
        </div>
        <div class="flex gap-1">
          <button type="button" class="hero-prev grid size-10 place-items-center rounded-full text-terza-black transition-colors hover:bg-terza-black hover:text-white" aria-label="Diapositiva anterior">
            <i class="ph ph-arrow-left"></i>
          </button>
          <button type="button" class="hero-next grid size-10 place-items-center rounded-full bg-terza-black text-white transition-colors hover:bg-terza-lime hover:text-terza-black" aria-label="Diapositiva siguiente">
            <i class="ph ph-arrow-right"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- ============ C. PRODUCTOS (GALERÍA) ============ -->
    <section id="productos" class="overflow-hidden py-24 md:py-36" aria-labelledby="productos-title">
      <div class="mx-auto max-w-[1440px] px-5 md:px-10">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <p class="eyebrow justify-center">Nuevos productos · Flexiroc</p>
          <h2 id="productos-title" class="mt-6 text-4xl font-light leading-tight md:text-6xl">
            Recubrimiento de <span class="font-medium">Piedra Flexible</span>
          </h2>
          <p class="mt-6 text-base leading-relaxed md:text-lg">
            Cada pieza conserva la veta, el poro y el relieve de la roca original. Elige el carácter que tu proyecto merece.
          </p>
        </div>
      </div>

      <div class="products-swiper swiper mt-16 !overflow-visible px-5 md:mt-20 md:px-10" data-reveal>
        <div class="swiper-wrapper">
          {productos.map((p) => (
            <article class="swiper-slide !h-auto">
              <a href={p.href} class="group block h-full rounded-2xl bg-white shadow-sm transition-shadow duration-700 ease-silk hover:shadow-xl">
                <div class="relative">
                  <div class="aspect-square overflow-hidden rounded-t-2xl">
                    <img
                      src={p.img}
                      alt={`Textura Flexiroc ${p.name}`}
                      width="640"
                      height="640"
                      loading="lazy"
                      class="size-full object-cover transition-transform duration-1000 ease-silk group-hover:scale-105"
                    />
                  </div>
                  <span class="absolute left-5 top-5 rounded-full bg-terza-lime px-3.5 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-terza-black">Nuevo</span>
                  <img
                    src={p.thumb}
                    alt=""
                    width="128"
                    height="128"
                    loading="lazy"
                    class="absolute -bottom-8 left-6 size-16 rounded-xl border-4 border-white object-cover shadow-md transition-transform duration-700 ease-silk group-hover:-translate-y-1"
                  />
                </div>
                <div class="flex items-end justify-between gap-4 px-6 pb-6 pt-12">
                  <div>
                    <h3 class="text-xl font-medium">Flexiroc {p.name}</h3>
                    <p class="mt-1 font-mono text-xs tracking-wide text-terza-gray/70">{p.code}</p>
                  </div>
                  <span class="grid size-11 shrink-0 place-items-center rounded-full border border-terza-black/10 text-terza-black transition-all duration-500 group-hover:border-terza-lime group-hover:bg-terza-lime">
                    <i class="ph ph-arrow-up-right"></i>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>

      <div class="mx-auto mt-12 flex max-w-[1440px] items-center gap-8 px-5 md:px-10">
        <div class="products-progress swiper-pagination !static !h-0.5 flex-1"></div>
        <a href="/catalogo/flexiroc" class="hidden items-center gap-2 text-sm font-semibold text-terza-black hover:text-terza-forest sm:inline-flex">
          Ver todo el catálogo <i class="ph ph-arrow-right"></i>
        </a>
        <div class="flex gap-2">
          <button type="button" class="products-prev grid size-12 place-items-center rounded-full border border-terza-black/10 text-terza-black transition-colors hover:bg-terza-black hover:text-white disabled:opacity-30" aria-label="Anterior">
            <i class="ph ph-arrow-left"></i>
          </button>
          <button type="button" class="products-next grid size-12 place-items-center rounded-full border border-terza-black/10 text-terza-black transition-colors hover:bg-terza-black hover:text-white disabled:opacity-30" aria-label="Siguiente">
            <i class="ph ph-arrow-right"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- ============ D. ABOUT / HISTORIA ============ -->
    <section id="nosotros" class="pb-24 md:pb-36" aria-labelledby="about-title">
      <div class="mx-auto grid max-w-[1440px] gap-12 px-5 md:px-10 lg:grid-cols-2 lg:gap-24">
        <div class="flex flex-col gap-10 lg:justify-center">
          <div>
            <p class="eyebrow" data-reveal>Desde 1979</p>
            <h2 id="about-title" class="about-title mt-8 text-[clamp(2.5rem,6vw,5.5rem)] font-light leading-[1] tracking-[-0.045em]">
              <span class="reveal-line block overflow-hidden pb-[0.08em]"><span>Todo para</span></span>
              <span class="reveal-line block overflow-hidden pb-[0.08em]"><span>transformar</span></span>
              <span class="reveal-line block overflow-hidden pb-[0.08em]"><span class="font-medium">tus espacios.</span></span>
            </h2>
          </div>

          <div data-reveal>
            <p class="max-w-md text-base leading-relaxed md:text-lg">
              Más de 45 años como referentes en superficies en México y Latinoamérica. Seleccionamos, fabricamos e instalamos materiales, con soluciones para interiores, exteriores y proyectos comerciales, con diseño, funcionalidad y alto desempeño.
            </p>
            <a href="#" class="btn-lime mt-10">Conoce Terza <i class="ph ph-arrow-right"></i></a>
          </div>
        </div>

        <!-- Imagen con tarjetas de cifras en escalera sobre su borde izquierdo -->
        <div class="about-media relative">
          <figure class="about-figure relative overflow-hidden rounded-2xl">
            <img
              src="/assets/images/img_quienes_somos.webp"
              alt="Sala residencial con piso de madera Terza y vista al Cerro de la Silla"
              width="1376"
              height="768"
              loading="lazy"
              class="about-img aspect-[4/5] size-full scale-110 object-cover object-[80%_center]"
            />
          </figure>

          <dl class="about-stats relative z-10 -mt-12 flex px-3 sm:px-6 lg:absolute lg:inset-y-0 lg:-left-32 lg:mt-0 lg:flex lg:flex-col lg:justify-center lg:gap-5 lg:px-0">
            {stats.map((s, i) => (
              <div class:list={[
                'stat-card rounded-2xl bg-terza-forest p-5 shadow-xl shadow-terza-black/10 lg:w-56 lg:p-6',
                ['lg:ml-0', 'lg:ml-8', 'lg:ml-16'][i],
              ]}>
                <dt class="sr-only">{s.unit ? `${s.unit} ${s.label}` : s.label}</dt>
                <dd class="flex flex-wrap items-baseline gap-x-2 font-display text-3xl font-light leading-none tracking-tight !text-white lg:text-5xl">
                  {s.value}
                  {s.unit && <span class="text-sm font-normal tracking-normal sm:text-base lg:text-xl">{s.unit}</span>}
                </dd>
                <dd class="mt-2 text-xs leading-snug !text-terza-lime lg:text-sm">{s.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ E. VISUALIZADOR ============ -->
    <section id="visualizador" class="px-5 md:px-10" aria-labelledby="viz-title">
      <div class="viz-box relative mx-auto flex max-w-[1440px] flex-col overflow-hidden rounded-3xl bg-neutral-50 lg:min-h-[640px] lg:flex-row lg:items-center">
        <!-- Imagen de fondo: en escritorio ocupa la derecha y se funde con el texto -->
        <div class="viz-bg relative order-last aspect-[3/2] w-full overflow-hidden lg:absolute lg:inset-y-0 lg:right-0 lg:order-none lg:aspect-auto lg:w-[72%]">
          <img
            src="/assets/images/decorador-virtual-terza.webp"
            alt="Persona usando el visualizador Terza en su celular para probar pisos en una sala"
            width="1536"
            height="1024"
            loading="lazy"
            class="viz-img size-full object-cover"
          />
          <div class="absolute inset-0 hidden bg-gradient-to-r from-neutral-50 from-10% via-neutral-50/80 via-30% to-transparent to-55% lg:block"></div>
        </div>

        <div class="px-6 py-16 md:px-16 md:py-24 lg:w-full">
          <div class="relative z-10 lg:w-[46%]" data-reveal>
            <p class="eyebrow">Decorador virtual</p>
            <h2 id="viz-title" class="mt-6 text-4xl font-light leading-tight md:text-6xl">
              Velo en tu espacio <span class="font-medium">antes de decidir.</span>
            </h2>
            <p class="mt-6 max-w-md text-base leading-relaxed md:text-lg">
              Toma una foto de tu sala, terraza o fachada y prueba cada piso, tapete y recubrimiento en segundos. Sin catálogos, sin suposiciones.
            </p>
            <ul class="mt-8 space-y-3 text-sm text-terza-black">
              <li class="flex items-center gap-3"><i class="ph ph-check-circle text-lg text-terza-forest"></i> Funciona desde tu celular</li>
              <li class="flex items-center gap-3"><i class="ph ph-check-circle text-lg text-terza-forest"></i> Compara acabados lado a lado</li>
              <li class="flex items-center gap-3"><i class="ph ph-check-circle text-lg text-terza-forest"></i> Comparte la propuesta con tu arquitecto</li>
            </ul>
            <a href="#" class="btn-lime mt-10">Prueba decorador <i class="ph ph-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ E2. SHAWCONTRACT (estilo acordeón de tarjetas) ============ -->
    <section id="shawcontract" class="pt-24 md:pt-36" aria-labelledby="shaw-title">
      <div class="mx-auto max-w-[1440px] px-5 md:px-10">
        <div class="mx-auto max-w-5xl text-center" data-reveal>
          <p class="eyebrow justify-center">Distribuidor exclusivo en México</p>
          <h2 id="shaw-title" class="mx-auto mt-10 w-[min(100%,1000px)] md:mt-12">
            <img src="/assets/images/shawcontract-logo.svg" width="274" height="60" alt="Shaw Contract" class="h-auto w-full" />
          </h2>
          <p class="mx-auto mt-8 max-w-2xl text-base leading-relaxed md:text-lg">
            Soluciones en alfombra modular, alfombra de rollo y pisos vinílicos para proyectos comerciales que exigen diseño y desempeño.
          </p>
          <a href="#" class="btn-lime mt-10">Conoce más <i class="ph ph-arrow-right"></i></a>
        </div>

        <!-- Tarjetas: en escritorio la que tiene el cursor se expande y su título pasa a horizontal -->
        <ul class="shaw-cards mt-16 flex flex-col gap-4 md:mt-20 lg:h-[600px] lg:flex-row">
          {shawSectores.map((sector) => (
            <li class="shaw-card group/card relative h-64 overflow-hidden rounded-2xl sm:h-80 lg:h-auto lg:flex-1 lg:transition-[flex-grow] lg:duration-700 lg:ease-silk lg:hover:grow-[3] lg:focus-within:grow-[3]">
              <a href="#" class="block size-full" aria-label={`ShawContract ${sector.name}: ${sector.desc}`}>
                <img
                  src={sector.img}
                  alt=""
                  loading="lazy"
                  class:list={['absolute inset-0 size-full object-cover transition-transform duration-1000 ease-silk lg:group-hover/card:scale-105', sector.pos]}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/35 to-black/25"></div>

                <!-- Título vertical (estado cerrado, solo escritorio) -->
                <span class="absolute inset-0 hidden items-center justify-center transition-opacity duration-300 lg:flex lg:group-hover/card:opacity-0 lg:group-focus-within/card:opacity-0">
                  <span class="rotate-180 font-display text-3xl font-medium uppercase tracking-[0.04em] text-white [writing-mode:vertical-rl] xl:text-4xl">
                    {sector.name}
                  </span>
                </span>

                <!-- Título horizontal (móvil siempre; escritorio al expandir) -->
                <span class="absolute inset-x-6 bottom-6 flex items-end justify-between gap-4 transition-opacity duration-500 lg:inset-x-8 lg:bottom-8 lg:opacity-0 lg:delay-200 lg:group-hover/card:opacity-100 lg:group-focus-within/card:opacity-100">
                  <span>
                    <span class="block font-display text-3xl font-medium uppercase tracking-[0.04em] text-white lg:text-5xl">{sector.name}</span>
                    <span class="mt-2 block text-sm text-white/80">{sector.desc}</span>
                  </span>
                  <span class="grid size-12 shrink-0 place-items-center rounded-full bg-terza-lime text-terza-black">
                    <i class="ph ph-arrow-up-right"></i>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ F. BLOG / IDEAS ============ -->
    <section id="ideas" class="py-24 md:py-36" aria-labelledby="ideas-title">
      <div class="mx-auto max-w-[1440px] px-5 md:px-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
          <div>
            <p class="eyebrow">Blog | Ideas</p>
            <h2 id="ideas-title" class="mt-6 text-4xl font-light leading-tight md:text-6xl">
              Ideas para transformar <span class="font-medium">tus espacios.</span>
            </h2>
            <p class="mt-6 max-w-xl text-base leading-relaxed md:text-lg">
              Consejos, tendencias y guías prácticas para crear espacios más funcionales, bonitos y duraderos.
            </p>
          </div>
          <a href="#" class="inline-flex items-center gap-2 text-sm font-semibold text-terza-black hover:text-terza-forest">
            Ver todas las ideas <i class="ph ph-arrow-right"></i>
          </a>
        </div>

        <div class="mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
          {posts.map((post) => (
            <article class="blog-card group" data-reveal>
              <a href={post.href} class="block">
                <div class="aspect-[19/10] overflow-hidden rounded-2xl">
                  <img
                    src={post.img}
                    alt=""
                    loading="lazy"
                    class="size-full object-cover transition-transform duration-1000 ease-silk group-hover:scale-105"
                  />
                </div>
                <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-terza-forest">{post.cat}</p>
                <hr class="my-4 border-terza-black/10 transition-colors duration-500 group-hover:border-terza-lime" />
                <div class="flex items-start justify-between gap-6">
                  <h3 class="text-lg font-medium leading-snug">{post.title}</h3>
                  <i class="ph-light ph-arrow-up-right mt-1 text-xl text-terza-black transition-transform duration-500 group-hover:-translate-y-1 group-hover:translate-x-1"></i>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ G. BANNER DISTRIBUIDOR ============ -->
    <section id="distribuidores" class="px-5 md:px-10" aria-labelledby="dist-title">
      <!-- En escritorio el verde termina donde empiezan las muestras: la imagen es el borde derecho del contenedor -->
      <div class="dist-banner mx-auto flex max-w-[1440px] flex-col lg:h-[340px] lg:flex-row">
        <div class="flex flex-col justify-center rounded-t-3xl bg-terza-forest px-6 pb-8 pt-10 md:px-16 md:pt-12 lg:flex-1 lg:rounded-l-3xl lg:rounded-tr-none lg:py-10">
          <div data-reveal>
            <p class="eyebrow !text-terza-lime">Distribuidores</p>
            <h2 id="dist-title" class="mt-4 text-3xl font-light leading-tight !text-white md:text-4xl">
              Lleva Terza <span class="font-medium">a tu ciudad.</span>
            </h2>
            <p class="mt-4 max-w-lg text-base leading-relaxed text-white/75">
              Súmate a la red de distribuidores autorizados con respaldo de marca, capacitación técnica, material de exhibición y condiciones comerciales preferentes.
            </p>
            <a href="#contacto" class="btn-lime mt-6 hover:!bg-white hover:!text-terza-black">Quiero ser distribuidor <i class="ph ph-arrow-right"></i></a>
          </div>
        </div>
        <div class="-mt-px overflow-hidden rounded-b-3xl bg-terza-forest lg:mt-0 lg:h-full lg:shrink-0 lg:rounded-bl-none lg:rounded-r-3xl lg:bg-transparent">
          <img
            src="/assets/images/imge_distribuidores-recorte.webp"
            alt="Muestras de madera, alfombra, mármol y recubrimientos Terza"
            width="1334"
            height="1038"
            loading="lazy"
            class="dist-img block h-auto w-full lg:h-full lg:w-auto"
          />
        </div>
      </div>
    </section>

    <!-- ============ H. CONTACTO Y UBICACIONES (4 columnas: foto, texto, foto, texto) ============ -->
    <section id="contacto-ubicaciones" class="px-5 pt-24 md:px-10 md:pt-36" aria-label="Contacto y ubicaciones">
      <div class="mx-auto grid max-w-[1440px] gap-8 md:grid-cols-2 xl:grid-cols-4 xl:gap-10">
        <figure class="cu-photo overflow-hidden rounded-2xl">
          <img
            src="/assets/images/contacto-asesor.webp"
            alt="Asesor de Terza en la planta de producción"
            width="900"
            height="1200"
            loading="lazy"
            class="aspect-[3/4] size-full object-cover transition-transform duration-1000 ease-silk hover:scale-105"
          />
        </figure>
        <div class="flex flex-col justify-center py-4 md:py-0" data-reveal>
          <p class="eyebrow">Contáctanos</p>
          <h2 class="mt-6 text-4xl font-light leading-[1.05] md:text-5xl">
            ¿En qué podemos <span class="font-medium">ayudarte?</span>
          </h2>
          <p class="mt-6 text-base leading-relaxed">
            Ya sea que estés transformando un espacio o desarrollando un proyecto, estamos aquí para asesorarte.
          </p>
          <a href="#contacto" class="btn-lime mt-8 self-start">Contáctanos <i class="ph ph-arrow-right"></i></a>
        </div>

        <figure class="cu-photo overflow-hidden rounded-2xl">
          <img
            src="/assets/images/showroom-monterrey.webp"
            alt="Showroom de Terza en Monterrey con muestras de pisos y recubrimientos"
            width="900"
            height="1200"
            loading="lazy"
            class="aspect-[3/4] size-full object-cover transition-transform duration-1000 ease-silk hover:scale-105"
          />
        </figure>
        <div class="flex flex-col justify-center py-4 md:py-0" data-reveal>
          <p class="eyebrow">Nuestras ubicaciones</p>
          <h2 class="mt-6 text-4xl font-light leading-[1.05] md:text-5xl">
            Conoce nuestros <span class="font-medium">espacios.</span>
          </h2>
          <p class="mt-6 text-base leading-relaxed">
            Visita nuestro Showroom en Monterrey o descubre nuestras ubicaciones en México.
          </p>
          <a href="#contacto" class="btn-lime mt-8 self-start">Ver ubicaciones <i class="ph ph-arrow-right"></i></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script is:inline slot="scripts">
    document.addEventListener('DOMContentLoaded', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---------- Swiper: galería de productos ---------- */
      if (window.Swiper) {
        new Swiper('.products-swiper', {
          slidesPerView: 1.15,
          spaceBetween: 16,
          speed: 900,
          grabCursor: true,
          navigation: { prevEl: '.products-prev', nextEl: '.products-next' },
          pagination: { el: '.products-progress', type: 'progressbar' },
          breakpoints: {
            640: { slidesPerView: 2.15, spaceBetween: 20 },
            1024: { slidesPerView: 3.15, spaceBetween: 28 },
            1440: { slidesPerView: 3.6, spaceBetween: 32 },
          },
        });
      }

      /* ---------- GSAP ---------- */
      if (!window.gsap || reduceMotion) {
        document.documentElement.classList.remove('js');
        return;
      }
      gsap.registerPlugin(ScrollTrigger);
      gsap.defaults({ ease: 'expo.out', duration: 1.4 });

      // Hero: slider con barrido lateral, parallax entre imágenes y revelado de textos por máscara
      const hero = document.querySelector('.hero');
      const slides = gsap.utils.toArray('.hero-slide');
      const imgs = slides.map((slide) => slide.querySelector('.hero-img'));
      const shades = slides.map((slide) => slide.querySelector('.hero-slide-shade'));
      const copies = gsap.utils.toArray('.hero-copy-slide');
      const dots = gsap.utils.toArray('.hero-dot');
      const fills = dots.map((dot) => dot.querySelector('.hero-dot-fill'));
      const wipe = document.querySelector('.hero-wipe');
      const counter = document.querySelector('.hero-count-current');
      const AUTOPLAY = 7;
      let current = 0;
      let busy = false;
      let kenBurns;
      let progress;
      let hovering = false;
      let offscreen = false;

      const lines = (i) => copies[i].querySelectorAll('.reveal-line > span');
      const fades = (i) => copies[i].querySelectorAll('.hero-eyebrow, .hero-copy, .hero-ctas');
      gsap.set('.hero-copy-slide .reveal-line > span', { y: 0, yPercent: 110 });
      gsap.set(slides, { zIndex: (i) => (i === 0 ? 2 : 1) });

      const setFocusable = (i, on) => {
        copies[i].querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
        [copies[i], slides[i]].forEach((el) => (on ? el.removeAttribute('aria-hidden') : el.setAttribute('aria-hidden', 'true')));
      };

      const showCopy = (i) => {
        gsap.set(copies[i], { visibility: 'visible' });
        setFocusable(i, true);
        return gsap.timeline()
          .fromTo(lines(i), { yPercent: 110 }, { yPercent: 0, stagger: 0.12, duration: 1.3, ease: 'expo.out' }, 0)
          .fromTo(fades(i), { opacity: 0, y: 24 }, { opacity: 1, y: 0, stagger: 0.1, duration: 1.1, ease: 'expo.out' }, 0.25);
      };

      const hideCopy = (i) => {
        setFocusable(i, false);
        return gsap.timeline({ onComplete: () => gsap.set(copies[i], { visibility: 'hidden' }) })
          .to(fades(i), { opacity: 0, y: -16, stagger: 0.05, duration: 0.5, ease: 'power2.in' }, 0)
          .to(lines(i), { yPercent: -110, stagger: 0.06, duration: 0.7, ease: 'power3.in' }, 0);
      };

      const syncPause = () => {
        if (!progress) return;
        hovering || offscreen ? progress.pause() : progress.resume();
      };

      const startProgress = (i) => {
        progress?.kill();
        progress = gsap.fromTo(fills[i], { scaleX: 0 }, {
          scaleX: 1,
          duration: AUTOPLAY,
          ease: 'none',
          onComplete: () => goTo((current + 1) % slides.length, 1),
        });
        syncPause();
      };

      // Zoom lento mientras la imagen está activa
      const startKenBurns = (i) => {
        kenBurns?.kill();
        kenBurns = gsap.to(imgs[i], { scale: 1, duration: AUTOPLAY + 2, ease: 'none' });
      };

      function goTo(next, dir = 1) {
        if (busy || next === current) return;
        busy = true;
        progress?.kill();
        kenBurns?.kill();
        gsap.to(fills[current], { scaleX: 0, duration: 0.5, ease: 'power2.out' });

        const prev = current;
        current = next;
        counter.textContent = String(next + 1).padStart(2, '0');

        gsap.set(shades[next], { opacity: 0 });
        gsap.set(slides[prev], { zIndex: 2 });
        gsap.set(slides[next], {
          visibility: 'visible',
          zIndex: 3,
          clipPath: dir > 0 ? 'inset(0% 0% 0% 100%)' : 'inset(0% 100% 0% 0%)',
        });

        gsap.timeline({
          onComplete: () => {
            gsap.set(slides[prev], { visibility: 'hidden', zIndex: 1 });
            gsap.set(imgs[prev], { xPercent: 0, scale: 1.12 });
            gsap.set(shades[prev], { opacity: 0 });
            gsap.set(slides[next], { zIndex: 2, clearProps: 'clipPath' });
            busy = false;
            startKenBurns(next);
            startProgress(next);
          },
        })
          .add(hideCopy(prev), 0)
          .to(slides[next], { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.6, ease: 'expo.inOut' }, 0.2)
          .fromTo(imgs[next], { scale: 1.3, xPercent: dir * 12 }, { scale: 1.12, xPercent: 0, duration: 1.9, ease: 'expo.inOut' }, 0.2)
          .to(imgs[prev], { xPercent: -dir * 15, duration: 1.6, ease: 'expo.inOut' }, 0.2)
          .to(shades[prev], { opacity: 0.45, duration: 1.6, ease: 'expo.inOut' }, 0.2)
          .fromTo(wipe, { left: dir > 0 ? '100%' : '0%', opacity: 1 }, { left: dir > 0 ? '0%' : '100%', duration: 1.6, ease: 'expo.inOut' }, 0.2)
          .to(wipe, { opacity: 0, duration: 0.3 }, 1.6)
          .add(showCopy(next), 1.15);
      }

      const goNext = () => goTo((current + 1) % slides.length, 1);
      const goPrev = () => goTo((current - 1 + slides.length) % slides.length, -1);
      document.querySelector('.hero-next').addEventListener('click', goNext);
      document.querySelector('.hero-prev').addEventListener('click', goPrev);
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i, i > current ? 1 : -1)));

      // Pausa al pasar el cursor y cuando el hero sale de pantalla
      hero.addEventListener('mouseenter', () => { hovering = true; syncPause(); });
      hero.addEventListener('mouseleave', () => { hovering = false; syncPause(); });
      ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        onToggle: (self) => { offscreen = !self.isActive; syncPause(); },
      });

      // Deslizar con el dedo en móvil
      let touchX = null;
      hero.addEventListener('pointerdown', (e) => { touchX = e.clientX; });
      hero.addEventListener('pointerup', (e) => {
        if (touchX === null) return;
        const dx = e.clientX - touchX;
        touchX = null;
        if (Math.abs(dx) > 60) dx < 0 ? goNext() : goPrev();
      });

      // Entrada inicial
      gsap.timeline({ delay: 0.15, onComplete: () => { startKenBurns(0); startProgress(0); } })
        .fromTo(imgs[0], { scale: 1.25 }, { scale: 1.12, duration: 2.4, ease: 'power3.out' })
        .add(showCopy(0), 0.35)
        .fromTo('.site-header', { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 1, clearProps: 'transform,opacity' }, 0.5)
        .fromTo('.site-rail', { x: -30, opacity: 0 }, { x: 0, opacity: 1, duration: 1, clearProps: 'transform,opacity' }, 0.5)
        .fromTo('.hero-controls', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 1.2 }, 1);

      // Elementos genéricos [data-reveal] (excepto los del hero)
      gsap.utils.toArray('[data-reveal]').forEach((el) => {
        if (el.matches('.hero-eyebrow, .hero-copy, .hero-ctas, .blog-card')) return;
        gsap.fromTo(el, { opacity: 0, y: 40 }, {
          opacity: 1,
          y: 0,
          scrollTrigger: { trigger: el, start: 'top 85%' },
        });
      });

      // About: título con máscara + imagen con revelado tipo cortina y parallax
      gsap.to('.about-title .reveal-line > span', {
        y: 0,
        stagger: 0.12,
        scrollTrigger: { trigger: '.about-title', start: 'top 80%' },
      });
      gsap.fromTo('.about-figure', { clipPath: 'inset(100% 0% 0% 0%)' }, {
        clipPath: 'inset(0% 0% 0% 0%)',
        duration: 1.6,
        ease: 'expo.inOut',
        scrollTrigger: { trigger: '.about-figure', start: 'top 80%' },
      });
      gsap.fromTo('.stat-card', { opacity: 0, x: -40 }, {
        opacity: 1,
        x: 0,
        stagger: 0.15,
        delay: 0.6,
        scrollTrigger: { trigger: '.about-media', start: 'top 75%' },
      });
      gsap.to('.about-img', {
        yPercent: -8,
        ease: 'none',
        scrollTrigger: { trigger: '.about-figure', start: 'top bottom', end: 'bottom top', scrub: true },
      });

      // Visualizador: la imagen de fondo entra con un zoom suave
      gsap.fromTo('.viz-img', { scale: 1.12 }, {
        scale: 1,
        duration: 2,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.viz-box', start: 'top 75%' },
      });

      // ShawContract: tarjetas en cascada
      gsap.fromTo('.shaw-card', { opacity: 0, y: 60 }, {
        opacity: 1,
        y: 0,
        stagger: 0.12,
        scrollTrigger: { trigger: '.shaw-cards', start: 'top 85%' },
      });

      // Contacto y ubicaciones: fotos con revelado tipo cortina
      gsap.utils.toArray('.cu-photo').forEach((photo, i) => {
        gsap.fromTo(photo, { clipPath: 'inset(100% 0% 0% 0%)' }, {
          clipPath: 'inset(0% 0% 0% 0%)',
          duration: 1.6,
          delay: i * 0.15,
          ease: 'expo.inOut',
          scrollTrigger: { trigger: '#contacto-ubicaciones', start: 'top 80%' },
        });
      });

      // Blog: stagger de tarjetas
      // (un trigger por tarjeta: ScrollTrigger.batch puede dejarlas ocultas al recalcular posiciones)
      gsap.utils.toArray('.blog-card').forEach((card, i) => {
        gsap.fromTo(card, { opacity: 0, y: 50 }, { opacity: 1, y: 0, delay: i * 0.12, scrollTrigger: { trigger: card, start: 'top 88%' } });
      });

      // Banner distribuidor: entrada con escala sutil
      gsap.fromTo('.dist-banner', { scale: 0.96 }, {
        scale: 1,
        duration: 1.6,
        scrollTrigger: { trigger: '.dist-banner', start: 'top 85%' },
      });
    });
  </script>
</Layout>
