    cat: 'Muros',
    title: 'Tipos de lambrín: ¿Cómo elegir entre colores claros y oscuros para tus muros?',
    img: '/assets/images/blog-muros.webp',
    href: '#',
  },
];

// Menú del footer; `sep` deja un espacio antes del enlace para separar grupos
const footerCols = [
  {
    title: 'Productos',
    links: [
      { label: 'Pisos', href: '#' },
      { label: 'Muros', href: '#' },
      { label: 'Persianas', href: '#' },
      { label: 'Exterior', href: '#' },
      { label: 'Accesorios', href: '#' },
    ],
  },
  {
    title: 'Recursos',
    links: [
      { label: 'Catálogos digitales', href: 'https://www.terza.com/catalogos' },
      { label: 'Decorador Virtual', href: '#visualizador' },
