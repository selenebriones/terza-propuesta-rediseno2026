          Ver todo el catálogo <i class="ph ph-arrow-right"></i>
        </a>
        <div class="flex gap-2">
          <button type="button" class="products-prev grid size-12 place-items-center rounded-full border border-terza-black/10 text-terza-black transition-colors hover:bg-terza-black hover:text-white disabled:opacity-30" aria-label="Anterior">
            <i class="ph ph-arrow-left"></i>
          </button>
          <button type="button" class="products-next grid size-12 place-items-center rounded-full border border-terza-black/10 text-terza-black transition-colors hover:bg-terza-black hover:text-white disabled:opacity-30" aria-label="Siguiente">
            <i class="ph ph-arrow-right"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- ============ D. ABOUT / HISTORIA ============ -->
    <section id="nosotros" class="pb-24 md:pb-36" aria-labelledby="about-title">
      <div class="mx-auto grid max-w-[1440px] gap-12 px-5 md:px-10 lg:grid-cols-2 lg:gap-24">
        <div class="flex flex-col gap-10 lg:justify-center">
